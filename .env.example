# GEMINI_API_KEY: Automatically injected by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio with the Cloud Run service URL
APP_URL="MY_APP_URL"

# --- ADMIN AUTHENTICATION SECRETS ---
# Admin username (default if unset in preview: admin)
ADMIN_USERNAME="admin"
# Format: scrypt:16384:8:1:<saltHex>:<hashHex> (6 colon-separated parts)
# Generate via node -e or change directly inside Admin Panel -> Security
ADMIN_PASSWORD_HASH=""
# 32+ byte random secret for HMAC-signing user and admin sessions
SESSION_SECRET="replace_with_strong_random_session_secret_at_least_32_chars"

# --- DISCORD OAUTH2 & BOT SECRETS ---
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""
DISCORD_VERIFIED_ROLE_ID=""

# --- MINECRAFT PLUGIN & RCON DELIVERY SECRETS ---
# Shared HMAC-SHA256 secret between this store and the ADRENALINEE Minecraft server plugin
MC_PLUGIN_SECRET="replace_with_shared_mc_plugin_hmac_secret"
# Optional RCON connection for direct command execution
RCON_HOST=""
RCON_PORT="25575"
RCON_PASSWORD=""

# --- GEORGIAN PAYMENT GATEWAY SECRETS (Optional: BOG iPay / TBC / Flitt / Payze) ---
PAYMENT_WEBHOOK_SECRET="replace_with_payment_gateway_webhook_secret"
PAYMENT_MERCHANT_ID=""
